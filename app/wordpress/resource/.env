# 反向代理模式：访问域名与证书（由 install.sh 填写）
WORDPRESS_HOST=__WORDPRESS_HOST__
WORDPRESS_RESOLVER=__WORDPRESS_RESOLVER__
WORDPRESS_CERT_MAIN=__WORDPRESS_CERT_MAIN__
WORDPRESS_CERT_SANS=__WORDPRESS_CERT_SANS__
# 直接访问模式的宿主机端口（反向代理模式不使用）
WORDPRESS_PORT=__WORDPRESS_PORT__

# 数据库连接（容器模式由下方 wordpress-mysql 使用；外部模式由 install.sh 填写）
MYSQL_HOST=__MYSQL_HOST__
MYSQL_PORT=__MYSQL_PORT__
MYSQL_USER=__MYSQL_USER__
MYSQL_PASSWORD=__MYSQL_PASSWORD__
MYSQL_DATABASE=__MYSQL_DATABASE__
# 仅容器模式使用；外部模式安装时删除
MYSQL_ROOT_PASSWORD=__MYSQL_ROOT_PASSWORD__