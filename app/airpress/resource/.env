AIRPRESS_HOST=__AIRPRESS_HOST__
# 证书解析器（traefik resolver 池所选/新增，<根域名>@<提供商别名>）
AIRPRESS_RESOLVER=__AIRPRESS_RESOLVER__
# 通配证书声明：CERT_MAIN=*.根域名 CERT_SANS=根域名；
# 精确域名模式下两项为空串（label 空值被 Traefik 忽略，走单域名自动签发）
AIRPRESS_CERT_MAIN=__AIRPRESS_CERT_MAIN__
AIRPRESS_CERT_SANS=__AIRPRESS_CERT_SANS__
# 直接访问模式的宿主机端口（反向代理模式不使用）
AIRPRESS_PORT=__AIRPRESS_PORT__

MYSQL_USER=__MYSQL_USER__
MYSQL_PASSWORD=__MYSQL_PASSWORD__
MYSQL_HOST=__MYSQL_HOST__
MYSQL_PORT=__MYSQL_PORT__
MYSQL_DB=__MYSQL_DB__

MYSQL_INNODB_BUFFER_POOL_SIZE=__INNODB_BUFFER_POOL_SIZE__
MYSQL_INNODB_BUFFER_POOL_INSTANCES=__INNODB_BUFFER_POOL_INSTANCES__
MYSQL_INNODB_LOG_FILE_SIZE=__INNODB_LOG_FILE_SIZE__
